# Copy to .env.local and fill in. Never commit .env.local.

# Public brand name (working name — change once the platform name is decided)
NEXT_PUBLIC_APP_NAME=Magari
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — `supabase start` prints these for local development.
# Production values: Supabase dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---------------------------------------------------------------------------
# Server-only (never prefixed NEXT_PUBLIC_). Used by scheduled jobs and payment posting.
# ---------------------------------------------------------------------------
# Supabase → Project Settings → API Keys → secret key. Used only by trusted server operations.
SUPABASE_SECRET_KEY=
# Any long random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# SMS: "console" logs texts instead of sending (development, staging before the account exists).
SMS_PROVIDER=console
# AFRICASTALKING_USERNAME=      ("sandbox" for the Africa's Talking sandbox)
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=     (registered sender ID, e.g. MAGARI; optional)

# Email: "console" logs instead of sending; "resend" uses resend.com.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=Magari <alerts@example.co.ke>

# Payments. The mock checkout is local-only and must never be enabled in production.
PAYMENT_PROVIDER=mock
# Cashia and eTIMS credentials are added after merchant access and their integration
# contracts are supplied. Do not put private keys in NEXT_PUBLIC_* variables.
